---
/**
 * Pixel-art interactive scene: a dog that fetches a thrown 2L plastic bottle.
 * Click the bottle to throw it; click the dog while it carries the bottle to
 * make it drop it. Colors come from the site theme tokens.
 */
---

<div class="bottle-fetch">
	<canvas
		data-bottle-fetch
		tabindex="0"
		role="button"
		aria-label="Pixel-art dog park. Press Enter to throw the plastic bottle for the dog, or to ask the dog to drop it."
	></canvas>
	<div class="bottle-fetch__themes" role="group" aria-label="Color theme">
		<button
			class="theme-dot theme-dot--yellow"
			data-set-theme="yellow"
			aria-label="Yellow theme (day)"></button>
		<button
			class="theme-dot theme-dot--blue"
			data-set-theme="blue"
			aria-label="Blue theme (night)"></button>
		<button
			class="theme-dot theme-dot--pink"
			data-set-theme="pink"
			aria-label="Pink theme (morning)"></button>
	</div>
</div>

<script>
	import { mountBottleFetch } from "./bottle-fetch";
	mountBottleFetch();
</script>

<style>
	.bottle-fetch {
		position: relative;
		width: 100%;
	}
	.bottle-fetch canvas {
		display: block;
		width: 100%;
		border: 2px solid var(--clr-black);
		border-radius: var(--radius-md);
		image-rendering: pixelated;
		outline-offset: 2px;
	}
	.bottle-fetch__themes {
		position: absolute;
		top: var(--space-2);
		right: 10px;
		display: flex;
		gap: 6px;
	}
	.theme-dot {
		width: 15px;
		height: 15px;
		padding: 0;
		border: 2px solid var(--clr-black);
		border-radius: 50%;
		cursor: pointer;
		transition: transform var(--duration-fast) var(--ease-out);
	}
	.theme-dot:hover {
		transform: scale(1.25);
	}
	.theme-dot--yellow {
		background: var(--clr-yellow-500);
	}
	.theme-dot--blue {
		background: var(--clr-blueberry-500);
	}
	.theme-dot--pink {
		background: var(--clr-pink-500);
	}
	/* mark the active theme with an inner ring */
	:global(html:not([data-theme="blue"]):not([data-theme="pink"]))
		.theme-dot--yellow,
	:global(html[data-theme="blue"]) .theme-dot--blue,
	:global(html[data-theme="pink"]) .theme-dot--pink {
		box-shadow: inset 0 0 0 2px var(--clr-white);
	}
</style>
