---
import type { TPost } from "../../types/post";
import { POST_CATEGORY_LABELS } from "../../data/postCategories";
import LinkButton from "../common/LinkButton.astro";
import { entrySlug } from "../../lib/slug";
import { formatShortDate } from "../../lib/date";

/** A single post card in the blog roll grid, filterable by category via `data-category`. */
interface Props {
	post: TPost;
}
const { post } = Astro.props;
const slug = entrySlug(post);
---

<article class="blog-card" data-post-card data-category={post.data.category}>
	<div class="blog-card-content">
		<div class="blog-card-meta">
			<time datetime={post.data.pubDate.toISOString()} class="blog-date">
				{formatShortDate(post.data.pubDate)}
			</time>
			<span class="blog-category">
				{POST_CATEGORY_LABELS[post.data.category]}
			</span>
		</div>
		<h2>{post.data.title}</h2>
		<div class="blog-description-action">
			<p class="blog-desc">{post.data.description}</p>
			<LinkButton text="READ" href={`/blog/${slug}/`} variant="outline" />
		</div>
	</div>
</article>

<style>
	.blog-card {
		position: relative;
		background: var(--block-card-background);
		border-radius: var(--radius-md);
		padding: var(--space-4);
		display: flex;
		justify-content: space-between;
		width: 100%;
		min-height: 160px;
	}
	.blog-card:hover {
		background: var(--block-card-background-hover);
	}
	.blog-card-content {
		display: flex;
		flex-direction: column;

		min-width: 0;
		flex: 3;
		h2 {
			color: var(--block-card-text);
		}
	}
	.blog-card[hidden] {
		display: none;
	}
	.blog-card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--default-layout-gap);
		padding-bottom: 10px;
	}
	.blog-category {
		flex: none;
		font-family: var(--ff-heading);
		font-size: var(--fs-300);
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--badge-text);
		background: var(--badge-background);
		padding: 0.3rem 0.6rem;
	}
	.blog-description-action {
		margin-top: 10px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex: 1;
		color: var(--card-action-color);

		p {
			color: var(--block-card-text);
		}

		> a {
			border-color: var(--card-action-color);
			color: var(--card-action-color);
		}

		> a:hover {
			background-color: var(--card-action-background-hover);
			border-color: var(--card-action-background-hover);
			color: var(--card-action-color-hover);
		}
	}
	.blog-date {
		color: var(--text-blog-date);
		font-size: 14px;
		letter-spacing: 0.04em;
	}
	.blog-desc {
		color: var(--text-main);
		font-size: 1.1rem;
		margin: 0 0 var(--space-2) 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 899px) {
		.blog-card {
			padding: 1.2rem var(--space-4);
			height: auto;
			flex-direction: column;
			gap: 10px;
		}
		.blog-description-action {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
		}
	}
</style>
