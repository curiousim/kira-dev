---
interface Props {
	icon: "github" | "linkedin" | "flickr" | "strava" | "frontend-masters";
	label: string;
	href: string;
}

const { icon, label, href } = Astro.props;
---

<a
	class="social-button"
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`${label} (opens in a new tab)`}
	title={label}
>
	{
		icon === "github" && (
			<svg viewBox="0 0 24 24" role="img" aria-hidden="true">
				<path
					class="github"
					d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.2c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.28-1.29-5.28-5.69 0-1.26.45-2.28 1.19-3.08-.12-.3-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.82 1.19 3.08 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
				/>
			</svg>
		)
	}
	{
		icon === "linkedin" && (
			<svg viewBox="0 0 24 24" role="img" aria-hidden="true">
				<path
					class="linkedin"
					d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.54V9H7.1v11.45Z"
				/>
			</svg>
		)
	}
	{
		icon === "flickr" && (
			<svg viewBox="0 0 32 14" role="img" aria-hidden="true">
				<circle class="flickr-blue" cx="7" cy="7" r="7" />
				<circle class="flickr-pink" cx="25" cy="7" r="7" />
			</svg>
		)
	}
	{
		icon === "strava" && (
			<svg viewBox="0 0 24 24" role="img" aria-hidden="true">
				<rect
					class="strava-background"
					width="24"
					height="24"
					rx="3.6"
				/>
				<path
					class="strava-primary"
					d="m5.6 13.5 5.2-10.9 5.3 10.9h-3.4L10.8 9l-1.9 4.5Z"
				/>
				<path
					class="strava-secondary"
					d="m13.1 13.5 1.5 3.4 1.5-3.4h2.3l-3.8 7.9-3.7-7.9Z"
				/>
			</svg>
		)
	}
	{
		icon === "frontend-masters" && (
			<svg viewBox="0 0 24 18" role="img" aria-hidden="true">
				<path
					class="frontend-masters"
					d="M21.2 2.91c.2-.21.48-.31.89-.31.29 0 .58.04.86.12.37.12.72.27 1.04.46a35.47 35.47 0 0 0-2.45 10.73c0 .26.04.52.12.77.05.19.16.36.31.48a2.47 2.47 0 0 1-1.83.8c-.47.01-.9-.14-1.23-.44-.35-.29-.51-.79-.51-1.5 0-.35.04-.69.09-1.05.33-1.84.75-3.67 1.25-5.47l-.15.01-.11.1-4.71 7.16c-.49.18-1 .27-1.51.29-.28 0-.56-.06-.82-.18a1.13 1.13 0 0 1-.5-.62c.11-.82.18-1.65.22-2.48.07-1.13.12-2.27.16-3.41v-.68a.5.5 0 0 0-.05-.19.17.17 0 0 0-.13-.05c-1.04 1.87-1.94 3.44-2.7 4.71a26.45 26.45 0 0 1-2.07 3.11c-.44.61-.97 1.15-1.57 1.62-.47.34-.94.52-1.39.51-.49.01-.95-.19-1.28-.54a2.7 2.7 0 0 1-.69-1.48l.25.02c.55 0 1.08-.23 1.59-.69.6-.52 1.13-1.12 1.6-1.77.54-.74 1.1-1.58 1.66-2.51.57-.93 1.16-1.89 1.83-2.86.23-.39.53-.76.87-1.08.25-.23.58-.36.93-.35.23 0 .46.03.68.09.13.01.25-.08.25-.22-.08-1.04-.4-1.82-.93-2.38-.55-.54-1.31-.8-2.3-.8-.8-.02-1.58.18-2.27.55a6.25 6.25 0 0 0-1.85 1.5 7.29 7.29 0 0 0-1.68 4.67c0 .59.18.98.54 1.15-.21.29-.48.53-.8.7-.3.16-.63.25-.98.25-.48.01-.95-.16-1.3-.5C.19 10.85 0 10.32 0 9.59c0-.81.13-1.59.4-2.36a10.26 10.26 0 0 1 6.87-6.32C8.03.72 8.79.6 9.58.6c1.88 0 3.3.58 4.25 1.74.95 1.16 1.42 2.98 1.42 5.44 0 1.01-.03 2.02-.11 3.03h.16l.09-.11 1.74-2.53c.59-.83 2.74-3.99 3.33-4.84.03-.04.19-.32.38-.36l.37-.06Z"
				/>
			</svg>
		)
	}
</a>

<style>
	.social-button {
		display: grid;
		place-items: center;
		width: var(--space-7);
		height: var(--space-7);
		padding: var(--space-2);
		border: 0;
		border-radius: var(--radius-md);
		background: transparent;
		text-decoration: none;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.social-button:hover,
	.social-button:focus-visible {
		background: var(--social-button-hover-background);
		transform: translateY(-2px);
	}

	.social-button:focus-visible {
		outline: 2px solid var(--social-icon-primary);
		outline-offset: 2px;
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.github {
		fill: var(--social-icon-primary);
	}
	.linkedin {
		fill: var(--social-icon-primary);
	}
	.flickr-blue {
		fill: var(--social-icon-primary);
	}
	.flickr-pink {
		fill: var(--social-icon-secondary);
	}
	.strava-background {
		fill: transparent;
	}
	.strava-primary {
		fill: var(--social-icon-primary);
	}
	.strava-secondary {
		fill: var(--social-icon-secondary);
	}
	.frontend-masters {
		fill: var(--social-icon-primary);
	}

	@media (max-width: 899px) {
		.social-button {
			width: 36px;
			height: 36px;
			padding: 7px;
		}
	}
</style>
