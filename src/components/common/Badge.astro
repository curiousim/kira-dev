---
/**
 * Small uppercase label used for section tags ("BLOG", "PHOTOS") and post
 * categories. Purely presentational — no link, no interaction.
 *
 * @example
 * <Badge text="BOOKS" />
 */
interface Props {
	/** Label text. Rendered as-is; callers pass it pre-uppercased. */
	text: string;
}

const { text } = Astro.props;
---

<div class="badge">{text}</div>
<style>
	.badge {
		display: inline-block;
		font-family: var(--ff-heading);
		background-color: var(--badge-background);
		color: var(--badge-text);
		padding: 0 var(--space-4);
		font-size: var(--fs-400);
		font-weight: 400;
	}
</style>
