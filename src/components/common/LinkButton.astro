---
/**
 * Themed link styled as a button. Renders an `<a>`, never a `<button>` —
 * use for navigation only; for in-page actions use a real `<button>`.
 *
 * @example
 * <LinkButton text="Read" href="/blog/post/" variant="outline" />
 */
interface Props {
	/** `link` is borderless inline text; `colored`/`secondary` use accent surfaces. @default "outline" */
	variant?: "outline" | "link" | "colored" | "secondary";
	/** Visible label. Uppercased by CSS on `outline`/`colored`/`secondary` — pass natural case. */
	text: string;
	/** Destination. @default "#" */
	href?: string;
	/** Open in a new tab with `rel="noopener noreferrer"`. @default false */
	outside?: boolean;
}
const { variant = "outline", text, href = "#", outside = false } = Astro.props;
---

<a
	class={`button ${variant}`}
	href={href}
	target={outside ? "_blank" : undefined}
	rel={outside ? "noopener noreferrer" : undefined}>
	{text}
</a>

<style>
	.button {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		background-color: transparent;
		border: 1px solid var(--button-border-color);
		color: var(--button-border-color);
		text-align: center;
		text-transform: uppercase;
		font-size: var(--fs-400);
		cursor: pointer;
		min-width: min(200px, 100%);
		max-width: 100%;
		width: fit-content;
		height: var(--space-7);
		padding-inline: var(--space-4);
		font-family: var(--ff-heading);
		font-weight: 300;
		text-decoration: none;
	}

	.button:hover {
		border-color: var(--button-hover-background);
		background-color: var(--button-hover-background);
		color: var(--button-hover-color);
	}

	.button:focus-visible {
		outline: 2px solid var(--button-border-color);
		outline-offset: 2px;
	}

	.colored {
		background-color: var(--button-colored-background);
		border-color: var(--button-colored-background);
	}

	.outline {
		border: 1px solid var(--button-border-color);
	}

	.outline:hover {
		background-color: var(--button-hover-background);
		border-color: var(--button-hover-background);
	}

	.secondary {
		background-color: var(--button-secondary-background);
		border-color: var(--button-secondary-border);
		color: var(--button-secondary-text);
	}

	.link {
		border: none;
		background: transparent;
		min-width: auto;
		height: auto;
		padding: 0;
		text-decoration: underline;
		color: var(--button-link-color);
	}

	.link:hover {
		background: transparent;
		border: none;
		color: var(--button-hover-background);
	}
</style>
