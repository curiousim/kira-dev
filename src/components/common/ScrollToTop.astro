---
/** Button shown at the bottom of the mobile layout; scrolls the page back to the top. */
---

<div class="scroll-to-top-container">
	<button class="scroll-to-top-btn" data-scroll-to-top aria-label="Scroll to top">
		↑ Back To The Top
	</button>
</div>

<script>
	document
		.querySelector<HTMLButtonElement>("[data-scroll-to-top]")
		?.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
</script>

<style>
	.scroll-to-top-container {
		background-color: var(--surface-raised);
		padding: var(--default-layout-gap);
		border-radius: var(--radius-md);
		text-align: center;
	}
	.scroll-to-top-btn {
		background-color: transparent;
		border: none;
		font-family: var(--ff-heading);
		text-decoration: underline;
		text-transform: uppercase;
		color: var(--text-main);
		cursor: pointer;
		font-size: var(--fs-400);
		font-weight: 500;
	}
</style>
