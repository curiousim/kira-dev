---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import BlogInfoCard from "../../components/InfoCardContent/Blog.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher/ThemeSwitcher.astro";
import BlogRoll from "../../components/BlogRoll/BlogRoll.astro";
import BottleFetch from "../../components/BottleFetch/BottleFetch.astro";
---

<BaseLayout
	title="Blog – Kira Menshov"
	description="Blog posts by Kira Menshov on software, agentic AI, and the things I learn while building."
	image="/og/blog.png"
	imageWidth={1200}
	imageHeight={630}
>
	<MainLayout stretchLatest>
		<div slot="main" class="blog-main">
			<BlogRoll />
			<BottleFetch />
		</div>
		<ThemeSwitcher slot="theme" />
		<BlogInfoCard slot="latest" />
	</MainLayout>
</BaseLayout>
<style>
	.blog-main {
		display: flex;
		flex-direction: column;
		gap: var(--default-layout-gap);
		height: 100%;
	}

	.blog-main > :global(.block) {
		flex: 1;
	}
</style>
