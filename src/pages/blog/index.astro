---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import AboutInfoCard from "../../components/InfoCardContent/About.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher/ThemeSwitcher.astro";
import BlogRoll from "../../components/BlogRoll/BlogRoll.astro";
import BottleFetch from "../../components/BottleFetch/BottleFetch.astro";
import { PAGE_META } from "../../consts";
---

<BaseLayout
	title={PAGE_META.blog.title}
	description={PAGE_META.blog.description}
	image="/og/blog.png"
	imageWidth={1200}
	imageHeight={630}
>
	<MainLayout stretchLatest>
		<div slot="main" class="blog-main">
			<BlogRoll />
			<BottleFetch />
		</div>
		<ThemeSwitcher slot="theme" />
		<AboutInfoCard slot="latest" />
	</MainLayout>
</BaseLayout>
<style>
	.blog-main {
		display: flex;
		flex-direction: column;
		gap: var(--default-layout-gap);
		height: 100%;
	}

	.blog-main > :global(.block) {
		flex: 1;
	}
</style>
