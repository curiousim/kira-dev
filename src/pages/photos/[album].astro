---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import InfoCardMainPage from "../../components/InfoCardContent/MainPage.astro";
import PhotoGrid from "../../components/PhotoGallery/PhotoGrid.astro";
import Lightbox from "../../components/PhotoGallery/Lightbox.astro";

export async function getStaticPaths() {
	const albums = await getCollection("albums");
	return albums.map((album) => ({
		params: { album: album.id },
		props: album,
	}));
}

const album = Astro.props;
---

<PageLayout
	title={`${album.data.title} – Kira Menshov`}
	description={album.data.description ?? `Photo album: ${album.data.title}`}
	badge="PHOTOS"
	backLink={{ href: "/photos/", label: "Photos" }}
	growWithContent
>
	<InfoCardMainPage slot="sidebar" />
	<h1 class="album-title">{album.data.title}</h1>
	{
		album.data.description && (
			<p class="album-description">{album.data.description}</p>
		)
	}
	<PhotoGrid photos={album.data.photos} />
	<Lightbox slot="overlay" />
</PageLayout>

<style>
	.album-title {
		font-size: var(--fs-800);
		margin-bottom: var(--space-2);
	}
	.album-description {
		margin-bottom: var(--space-5);
	}
</style>
