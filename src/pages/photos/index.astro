---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import InfoCardMainPage from "../../components/InfoCardContent/MainPage.astro";
import { formatMonthYear } from "../../lib/date";

const albums = (await getCollection("albums")).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<PageLayout
	title="Photos – Kira Menshov"
	description="Photo albums by Kira Menshov."
	badge="PHOTOS"
	backLink={{ href: "/", label: "Main" }}
	growWithContent
>
	<InfoCardMainPage slot="sidebar" />
	<ul class="album-list" role="list">
		{
			albums.map((album) => {
				const cover = album.data.cover ?? album.data.photos[0].src;
				return (
					<li class="album-card">
						<a href={`/photos/${album.id}/`} class="album-link">
							<Image
								src={cover}
								alt=""
								widths={[320, 640, 960]}
								sizes="(max-width: 899px) 90vw, 420px"
								width={640}
								class="album-cover"
								loading="lazy"
							/>
							<div class="album-meta">
								<h2>{album.data.title}</h2>
								<p class="album-info">
									{formatMonthYear(album.data.pubDate)}
									{" · "}
									{album.data.photos.length} photos
								</p>
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>
</PageLayout>

<style>
	.album-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(280px, 100%), 1fr)
		);
		gap: var(--default-layout-gap);
	}
	.album-card {
		background: var(--block-card-background);
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.album-card:hover {
		background: var(--block-card-background-hover);
	}
	.album-link {
		display: block;
		text-decoration: none;
	}
	.album-cover {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		display: block;
	}
	.album-meta {
		padding: var(--space-4);
	}
	.album-meta h2 {
		color: var(--block-card-text);
		font-size: var(--fs-600);
		margin-bottom: var(--space-1);
	}
	.album-info {
		color: var(--text-blog-date);
		font-size: var(--fs-300);
		margin: 0;
	}
</style>
