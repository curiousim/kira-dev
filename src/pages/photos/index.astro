---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Block from "../../components/common/Block.astro";
import Badge from "../../components/common/Badge.astro";
import LinkButton from "../../components/common/LinkButton.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher/ThemeSwitcher.astro";
import InfoCardMainPage from "../../components/InfoCardContent/MainPage.astro";

const albums = (await getCollection("albums")).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
	title="Photos – Kira Menshov"
	description="Photo albums by Kira Menshov.">
	<MainLayout>
		<Block slot="main" growWithContent={true}>
			<div class="albums-header">
				<LinkButton text="<-- Main" href="/" variant="link" />
				<Badge text="PHOTOS" />
			</div>
			<ul class="album-list" role="list">
				{
					albums.map((album) => {
						const cover =
							album.data.cover ?? album.data.photos[0].src;
						return (
							<li class="album-card">
								<a
									href={`/photos/${album.id}/`}
									class="album-link">
									<Image
										src={cover}
										alt=""
										widths={[320, 640, 960]}
										sizes="(max-width: 900px) 90vw, 420px"
										width={640}
										class="album-cover"
										loading="lazy"
									/>
									<div class="album-meta">
										<h2>{album.data.title}</h2>
										<p class="album-info">
											{album.data.pubDate.toLocaleDateString(
												"en-US",
												{
													year: "numeric",
													month: "long",
												}
											)}
											{" · "}
											{album.data.photos.length} photos
										</p>
									</div>
								</a>
							</li>
						);
					})
				}
			</ul>
		</Block>
		<ThemeSwitcher slot="theme" />
		<InfoCardMainPage slot="latest" />
	</MainLayout>
</BaseLayout>

<style>
	.albums-header {
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.album-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(280px, 100%), 1fr)
		);
		gap: var(--default-layout-gap);
	}
	.album-card {
		background: var(--block-card-background);
		border-radius: var(--radii-10);
		overflow: hidden;
	}
	.album-card:hover {
		background: var(--block-card-background-hover);
	}
	.album-link {
		display: block;
		text-decoration: none;
	}
	.album-cover {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		display: block;
	}
	.album-meta {
		padding: 1rem;
	}
	.album-meta h2 {
		color: var(--block-card-text);
		font-size: var(--fs-600);
		margin-bottom: 0.25rem;
	}
	.album-info {
		color: var(--text-blog-date);
		font-size: var(--fs-300);
		margin: 0;
	}
</style>
