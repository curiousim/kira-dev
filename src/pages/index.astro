---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import MainLayout from "../layouts/MainLayout.astro";
import InfoCardMainPage from "../components/InfoCardContent/MainPage.astro";
import Block from "../components/common/Block.astro";
import LinkButton from "../components/common/LinkButton.astro";
import SocialIconButton from "../components/common/SocialIconButton.astro";
import ThemeSwitcher from "../components/ThemeSwitcher/ThemeSwitcher.astro";
import { personSchema, websiteSchema } from "../lib/schema";
import { PAGE_META } from "../consts";

const yearsInTheField = new Date().getFullYear() - 2019;
---

<BaseLayout
	title={PAGE_META.index.title}
	description={PAGE_META.index.description}
	image="/og/index.png"
	imageAlt="Kira Menshov — Software engineer"
	imageWidth={1200}
	imageHeight={630}
>
	<JsonLd schema={[websiteSchema, personSchema]} />
	<MainLayout stretchLatest>
		<Block slot="main">
			<div class="main-content">
				<h1 class="main-title">
					Hi,<br />I'm Kira<br />Front-End Developer
				</h1>
				<div class="intro">
					<p>
						Well, <u>mostly</u> a front-end developer. I happened to fall
						into this rabbit hole {yearsInTheField}+ years ago, and
						while I’m interested in many other things outside of
						front-end, my main focus is still web development. But I
						think, in general, I just like to build things, solve
						problems, and learn about new technologies.
					</p>

					<p>
						I worked at <a href="https://cheq.ai/">Cheq</a>,
						<a href="https://esh.com/">EshOS</a>, and
						<a href="https://torq.io/">Torq</a> as a senior front-end
						developer. But frankly, I feel like a forever junior — there
						is so much to learn and explore in this field. The difference
						is that now I know how many more areas and technologies are
						out there.
					</p>

					<p>
						I also love to write and try to put on paper, quite
						literally 📖🖋️, everything I learn. So why not share it
						with others?
					</p>
				</div>
				<div class="button-groups">
					<div class="primary-buttons">
						<LinkButton
							text="Blog -->"
							href="/blog/"
							variant="outline"
						/>
						<LinkButton
							text="Books -->"
							href="/books/"
							variant="outline"
						/>
					</div>
					<div class="social-buttons" aria-label="Kira elsewhere">
						<SocialIconButton
							icon="github"
							label="GitHub"
							href="https://github.com/curiousim"
						/>
						<SocialIconButton
							icon="linkedin"
							label="LinkedIn"
							href="https://www.linkedin.com/in/kira-menshov-b447b72a/"
						/>
						<SocialIconButton
							icon="flickr"
							label="Flickr"
							href="https://www.flickr.com/photos/204721301@N03/"
						/>
						<SocialIconButton
							icon="strava"
							label="Strava"
							href="https://www.strava.com/athletes/21237811"
						/>
						<SocialIconButton
							icon="frontend-masters"
							label="Frontend Masters"
							href="https://master.dev/u/kiramenshov/"
						/>
					</div>
				</div>
			</div>
		</Block>
		<div slot="theme">
			<ThemeSwitcher />
		</div>
		<InfoCardMainPage slot="latest" />
	</MainLayout>
</BaseLayout>
<style>
	.main-content {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.main-title {
		margin-top: 50px;
		margin-bottom: 62px;
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		color: var(--text-main);
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.button-groups {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		margin-top: auto;
	}
	.primary-buttons,
	.social-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
	}
	.primary-buttons {
		width: 100%;
	}
	.social-buttons {
		gap: var(--space-3);
	}
	@media (max-width: 899px) {
		.main-title {
			margin-top: 0;
			margin-bottom: 36px;
		}

		.button-groups {
			margin-top: 50px;
		}
		.primary-buttons {
			width: 100%;
			gap: var(--space-4);
		}
		.social-buttons {
			gap: var(--space-2);
		}
		.primary-buttons :global(a) {
			flex: 1;
		}
	}
</style>
