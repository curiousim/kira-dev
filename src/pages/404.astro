---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Block from "../components/common/Block.astro";
import LinkButton from "../components/common/LinkButton.astro";
import ThemeSwitcher from "../components/ThemeSwitcher/ThemeSwitcher.astro";
import InfoCardMainPage from "../components/InfoCardContent/MainPage.astro";
---

<BaseLayout title="404 – Kira Menshov" description="Page not found.">
	<MainLayout>
		<Block slot="main">
			<div class="not-found">
				<h1>404</h1>
				<p>This page doesn't exist. Maybe it never did.</p>
				<LinkButton text="<-- Home" href="/" variant="outline" />
			</div>
		</Block>
		<ThemeSwitcher slot="theme" />
		<InfoCardMainPage slot="latest" />
	</MainLayout>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		margin-top: 50px;
	}
</style>
