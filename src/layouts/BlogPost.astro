---
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import MainLayout from "./MainLayout.astro";
import Block from "../components/common/Block.astro";
import ThemeSwitcher from "../components/ThemeSwitcher/ThemeSwitcher.astro";
import InfoCardBlogPost from "../components/InfoCardContent/Blog.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import BottleFetch from "../components/BottleFetch/BottleFetch.astro";
import { blogPostingSchema } from "../lib/schema";
import { formatDate } from "../lib/date";
import {
	POST_CATEGORY_LABELS,
	type PostCategory,
} from "../data/postCategories";

/**
 * Post/page shell for anything backed by markdown content: blog posts and
 * the About page (which reuses it with no `pubDate`/`category`, rendering
 * as an "ABOUT"-badged page instead of a dated article).
 */
interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	category?: PostCategory;
	/** Overrides the generated OG card with a specific image. */
	heroImage?: string;
	/** Post slug, used to build the generated OG card path. */
	slug?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	category,
	heroImage,
	slug,
} = Astro.props;
const isGeneratedCard = !heroImage;
const ogImage =
	heroImage ?? (slug ? `/og/blog/${slug}.png` : "/og/default.png");
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absoluteImage = new URL(ogImage, Astro.site ?? Astro.url).toString();
const articleSchema = pubDate
	? blogPostingSchema({
			title,
			description,
			url: pageUrl,
			image: absoluteImage,
			pubDate,
			updatedDate,
			tags: category ? [category, ...tags] : tags,
		})
	: undefined;

const headerBadge = category
	? POST_CATEGORY_LABELS[category as PostCategory].toUpperCase()
	: "ABOUT";
const pubDateFormatted = pubDate ? formatDate(pubDate) : "";
---

<BaseLayout
	title={title}
	description={description}
	image={ogImage}
	imageWidth={isGeneratedCard ? 1200 : undefined}
	imageHeight={isGeneratedCard ? 630 : undefined}
	type={pubDate ? "article" : "website"}
	pubDate={pubDate}
	updatedDate={updatedDate}
	tags={category ? [category, ...tags] : tags}
>
	{articleSchema && <JsonLd schema={articleSchema} />}
	<MainLayout stretchLatest>
		<Block slot="main">
			<SectionHeader
				backHref="/blog/"
				backLabel="Back to Blog"
				badge={headerBadge}
			/>
			{
				pubDate && (
					<div class="article-meta">
						<span class="article-date">{pubDateFormatted}</span>
					</div>
				)
			}
			<h1 class="article-title">{title}</h1>
			<div class="article-content">
				<slot />
			</div>
			<div class="article-widget">
				<BottleFetch />
			</div>
		</Block>
		<ThemeSwitcher slot="theme" />
		<InfoCardBlogPost slot="latest" />
	</MainLayout>
</BaseLayout>

<style>
	.article-meta {
		margin-bottom: var(--space-2);
	}
	.article-date {
		color: var(--text-blog-date);
		font-size: var(--fs-400);
		font-family: var(--ff-heading);
		letter-spacing: 0.04em;
	}
	.article-title {
		font-family: var(--ff-heading);
		font-size: 2.7rem;
		font-weight: 700;
		margin: 0 0 var(--space-6) 0;
		color: var(--text-main);
		line-height: 1.1;
		word-break: break-word;
	}
	.article-content {
		color: var(--text-main);
		font-size: 1.18rem;
		line-height: 1.7;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		padding-bottom: var(--space-7);
	}
	.article-widget {
		padding-bottom: var(--space-7);
	}
	.article-content :global(:not(pre) > code) {
		font-family: var(--ff-heading);
		background: var(--code-background);
		color: var(--code-text);
		border-radius: 0.5em;
		padding: 0.2em 0.5em;
		font-size: 0.95em;
	}
	.article-content :global(pre) {
		padding: 1em;
		overflow-x: auto;
		border-radius: var(--radius-md);
		margin: 1.5em 0;
	}
	:global(.article-content a) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
		cursor: pointer;
		transition: color var(--duration-fast) var(--ease-out);
	}
	:global(.article-content a:hover),
	:global(.article-content a:focus-visible) {
		color: var(--badge-background);
	}
	:global(.article-content img) {
		display: block;
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		margin: 0 auto;
	}
	:global(.article-content .post-hero) {
		max-width: 100%;
	}
	:global(.article-content .post-figure) {
		max-width: 480px;
		margin: 0 auto;
	}
	:global(.article-content .post-figure-sm) {
		max-width: 360px;
		margin: 0 auto;
	}
	@media (max-width: 899px) {
		.article-title {
			font-size: var(--fs-700);
		}
		.article-content {
			font-size: var(--fs-400);
		}
	}
</style>
