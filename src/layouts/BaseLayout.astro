---
import BaseHead from "../components/BaseHead.astro";

/**
 * Document root: `<html>`/`<head>`/`<body>` plus the FOUC-prevention inline
 * script that applies the saved theme before first paint. Every page
 * renders through this (usually via `PageLayout`, not directly).
 */
interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	type?: "website" | "article";
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	/** Adds `<meta name="robots" content="noindex">` — used by the /design style guide. @default false */
	noindex?: boolean;
}

const headProps = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...headProps} />
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme)
					document.documentElement.setAttribute("data-theme", theme);
			} catch {
				// localStorage unavailable — falls back to the default theme.
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
